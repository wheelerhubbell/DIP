{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.wheelerhubbell.com/vertical-registry.json",
  "title": "Decision Integrity Vertical Registry",
  "type": "object",
  "required": ["verticals"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "verticals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "core_decision", "vocabulary", "evidence_types", "authority_roles", "example_request", "discovery_terms"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 2 },
          "core_decision": { "type": "string", "minLength": 10 },
          "classification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["system", "code", "title"],
            "properties": {
              "system": { "const": "NAICS-2022" },
              "code": { "type": "string", "pattern": "^[0-9]{6}$" },
              "title": { "type": "string", "minLength": 3 },
              "source_url": { "type": "string", "format": "uri" }
            }
          },
          "vocabulary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primary_actor", "artifact", "validation_event"],
            "properties": {
              "primary_actor": { "type": "string", "minLength": 2 },
              "artifact": { "type": "string", "minLength": 2 },
              "validation_event": { "type": "string", "minLength": 2 }
            }
          },
          "evidence_types": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
          "authority_roles": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
          "regulatory_authorities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 2 },
                "jurisdiction": { "type": "string", "minLength": 2 }
              }
            },
            "uniqueItems": true
          },
          "standards": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 2 },
                "citation": { "type": "string", "minLength": 2 }
              }
            },
            "uniqueItems": true
          },
          "liabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 }, "uniqueItems": true },
          "authoritative_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "title", "url"],
              "properties": {
                "kind": { "enum": ["taxonomy", "regulator", "statute", "regulation", "standard", "official-guidance"] },
                "title": { "type": "string", "minLength": 3 },
                "url": { "type": "string", "format": "uri" }
              }
            }
          },
          "example_request": { "type": "string", "minLength": 10 },
          "discovery_terms": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 2 }, "uniqueItems": true }
        }
      }
    }
  }
}
