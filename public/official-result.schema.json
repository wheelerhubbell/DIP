{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wheelerhubbell.example/dip/1.0.0-rc.1/official-result.schema.json",
  "title": "WHP Official DIP Result Envelope v1",
  "type": "object",
  "required": ["envelopeVersion", "protocol", "release", "releaseSha256", "resultId", "inputDigest", "resultDigest", "issuedAt", "keyId", "result", "signature"],
  "properties": {
    "envelopeVersion": { "const": "WHP-DIP-OFFICIAL-RESULT-v1" },
    "protocol": { "const": "Decision Integrity Protocol" },
    "release": { "const": "1.0.0-rc.1" },
    "releaseSha256": { "const": "6a73d326d071c8c297609b74a55f4bf6328012ff446ac83cc58fb9a6374c6263" },
    "resultId": { "type": "string", "minLength": 1 },
    "inputDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "resultDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issuedAt": { "type": "string" },
    "keyId": { "type": "string", "minLength": 1 },
    "result": {
      "type": "object",
      "required": ["id", "protocolVersion", "resultClass", "grantedForce", "requestedForce", "resultingStanding", "halts", "boundedConditions", "residue", "auditTrace"],
      "properties": {
        "id": { "type": "string" },
        "protocolVersion": { "const": "1.0.0-rc.1" },
        "resultClass": { "enum": ["AUTHORIZED", "BOUNDED", "DENIED", "AWAITING_AUTHORITY"] },
        "grantedForce": { "type": ["string", "null"] },
        "requestedForce": { "type": "string" },
        "resultingStanding": { "type": ["object", "null"] },
        "halts": { "type": "array" },
        "boundedConditions": { "type": "array", "items": { "type": "string" } },
        "residue": { "type": "array", "items": { "type": "string" } },
        "auditTrace": {
          "type": "object",
          "required": ["id", "protocolVersion", "steps", "inputDigest", "resultDigest"],
          "properties": {
            "id": { "type": "string" },
            "protocolVersion": { "const": "1.0.0-rc.1" },
            "steps": { "type": "array" },
            "inputDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "resultDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "encoding", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "encoding": { "const": "base64" },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}